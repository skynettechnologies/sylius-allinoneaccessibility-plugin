{
    "name": "skynettechnologies/sylius-allinoneaccessibility-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "sylius-allinoneaccessibility"
    ],
    "description": "Quick Web Accessibility Implementation with All In One Accessibility!",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Skynettechnologies\\SyliusAllinOneAccessibilityPlugin\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Skynet Technologies USA LLC",
            "email": "developer3@skynettechnologies.com",
            "role": "Developer",
            "homepage": "https://skynettechnologies.com"
        }
    ],
    "autoload-dev": {
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    }
}
